RewriteEngine On
RewriteBase /hotel/

# 1. Правило для Админки
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.*)/(.*)$ index.php?controller=$1&action=$2&admin_area=1 [QSA,L]

# 2. Общее правило для всех остальных страниц
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/(.*)$ index.php?controller=$1&action=$2 [QSA,L]